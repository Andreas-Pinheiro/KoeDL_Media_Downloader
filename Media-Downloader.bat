pre{background:#0a0d14;color:#9ef0b4;padding:10px;border-radius:10px;height:220px;overflow:auto;font-size:.75rem;white-space:pre-wrap;margin:6px 0 0}
#fails{color:var(--bad);white-space:pre-wrap;font-size:.85rem;margin-top:8px}#alts{color:var(--ok);white-space:pre-wrap;font-size:.85rem;margin-top:8px}
progress{width:100%;height:10px;accent-color:var(--ac)}
#bar{flex:none;margin:0 -16px;background:var(--card);border-top:1px solid var(--line);box-shadow:0 -6px 20px rgba(0,0,0,.12);padding:10px 16px;z-index:5}
#bar .in{max-width:1500px;margin:0 auto;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
#bar .st{flex:1;min-width:200px}#bar .st b{display:block;font-size:.95rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#cur{color:var(--mu);font-size:.8rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sw{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.sw button{width:30px;height:30px;padding:0;border-radius:50%;border:2px solid var(--card);box-shadow:0 0 0 1px var(--line)}
.sw button.on{box-shadow:0 0 0 2px var(--fg)}
.sw input[type=color]{width:36px;height:30px;padding:0;border:0;background:none}
hr{border:0;border-top:1px solid var(--line);margin:12px 0}
footer{flex:none;margin:4px 0 6px;text-align:center;color:var(--mu);font-size:.75rem}footer a{color:inherit}
.hide{display:none!important}
body:not([data-tab=cfg]) #dt:not(.has){display:none}
@media(max-width:560px){.row>*{min-width:100%}#bar .in{gap:8px}}
.sup{display:grid;grid-template-columns:minmax(190px,40%) 1fr;gap:22px;align-items:center;position:relative;overflow:hidden}
.sup-art{position:relative;height:clamp(200px,42vh,380px);display:flex;align-items:flex-end;justify-content:center}
.sup-glow{position:absolute;inset:8% 4% 0;background:radial-gradient(closest-side,rgba(124,58,237,.55),rgba(34,211,238,.18) 60%,transparent 75%);filter:blur(14px);animation:supglow 4s ease-in-out infinite}
@keyframes supglow{0%,100%{opacity:.7;transform:scale(.96)}50%{opacity:1;transform:scale(1.04)}}
.sup-art img{position:absolute;bottom:0;left:50%;max-height:100%;max-width:100%;transform:translateX(-50%) scale(.94);opacity:0;transition:opacity .28s ease,transform .35s cubic-bezier(.2,1.4,.4,1);filter:drop-shadow(0 6px 18px rgba(0,0,0,.45))}
.sup-art img.on{opacity:1;transform:translateX(-50%) scale(1);animation:supbob 3.4s ease-in-out infinite}
@keyframes supbob{0%,100%{margin-bottom:0}50%{margin-bottom:6px}}
.spk{position:absolute;color:#22d3ee;font-size:18px;text-shadow:0 0 8px currentColor;animation:suptw 2.6s ease-in-out infinite;pointer-events:none}
.k1{left:6%;top:18%}.k2{right:8%;top:34%;color:#f472b6;animation-delay:.9s;font-size:14px}.k3{left:12%;bottom:22%;color:#a78bfa;animation-delay:1.7s;font-size:12px}
@keyframes suptw{0%,100%{opacity:.15;transform:scale(.6) rotate(0)}50%{opacity:1;transform:scale(1.15) rotate(25deg)}}
.sup-body h2{font-size:1.5rem;margin:0 0 6px}.sup-body p{margin:0 0 14px;line-height:1.5}
.sup-act{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px}.sup-act:empty{display:none}
.sup-act button{padding:12px 20px;font-size:1.02rem;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--ac),#22d3ee);border:0;border-radius:var(--rad,12px);box-shadow:0 6px 20px rgba(124,58,237,.45);transition:transform .15s}
.sup-act button:hover{transform:translateY(-2px) scale(1.03)}
.sup-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.tile{display:flex;flex-direction:column;align-items:flex-start;gap:2px;padding:12px;text-align:left;background:var(--card2);border:1px solid var(--line);border-radius:var(--rad,12px);color:var(--fg);transition:transform .15s,border-color .15s}
.tile:hover{transform:translateY(-2px);border-color:var(--ac)}.tile b{font-size:1.3rem}.tile span{font-weight:700}.tile small{color:var(--mu);font-size:.78rem;line-height:1.3}
.sup-note{margin-top:12px!important;font-size:.8rem}.sup-thx{min-height:1.4em;font-weight:700;color:var(--ok)}
@media(max-width:700px){.sup{grid-template-columns:1fr}.sup-art{height:220px}.sup-tiles{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.sup-glow,.spk,.sup-art img.on{animation:none}}
#main>#p_sup.on{flex:none}
#curfx{position:fixed;left:0;top:0;pointer-events:none;z-index:2147483647;display:none;will-change:transform}#curfx img{display:block;animation:fxglow 1.9s ease-in-out infinite}
@keyframes fxglow{0%,100%{filter:drop-shadow(0 0 2px rgba(34,211,238,.55))}50%{filter:drop-shadow(0 0 7px rgba(167,139,250,.95))}}
.fxs{position:fixed;pointer-events:none;z-index:2147483646;animation:fxs .7s ease-out forwards;text-shadow:0 0 6px currentColor}
@keyframes fxs{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-16px) scale(.3)}}
